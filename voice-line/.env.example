# Voice Line - Environment Variables
# Copy this to .env and fill in your values

# ── Required ──────────────────────────────────────────
# OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxx

# ── Supabase (optional, for conversation persistence) ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── OpenRouter Options ─────────────────────────────────
# Model to use (change to any OpenRouter model ID, add :free suffix for free tier)
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
# Site info sent to OpenRouter for ranking
OPENROUTER_SITE_URL=https://voice-line.local
OPENROUTER_SITE_NAME=Voice Line

# ── TTS: ElevenLabs (optional premium path) ────────────
ELEVENLABS_API_KEY=

# ── Voice Line Settings ────────────────────────────────
# PTT hotkey (default: alt_r)
VOICE_LINE_HOTKEY=alt_r
